{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtuann.github.io/logos/schema/kb/person-profile.schema.json",
  "title": "Hồ sơ triết gia (data/people/<id>.yml)",
  "description": "Phần văn của trang triet-gia/<id>.md, chuyển nguyên văn từ CONTENT trong tools/philosophers.py (quyết định 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "desc",
    "bio",
    "works",
    "thoughts",
    "argument",
    "misread",
    "related",
    "sources"
  ],
  "properties": {
    "desc": {
      "$ref": "#/$defs/text"
    },
    "bio": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "title",
          "note"
        ],
        "properties": {
          "year": {
            "type": "string"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "thoughts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "premises",
        "conclusion"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "intro": {
          "$ref": "#/$defs/text"
        },
        "conclusion": {
          "$ref": "#/$defs/text"
        },
        "objection": {
          "$ref": "#/$defs/text"
        },
        "reply": {
          "$ref": "#/$defs/text"
        },
        "premises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "orig",
        "vi",
        "url"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "orig": {
          "type": "string"
        },
        "vi": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "misread": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "title"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\.md(#[\\w-]+)?$"
          },
          "title": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "url"
        ],
        "properties": {
          "text": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/url"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    }
  }
}
