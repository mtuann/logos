{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtuann.github.io/logos/schema/kb/sources.schema.json",
  "title": "Nguồn (data/kb/sources.yml)",
  "description": "Mỗi URL một bản ghi, gộp từ mọi mục Nguồn và sources của hồ sơ. archive: bản lưu theo quý (SEP, quyết định 14), chỉ ghi khi đã mở được.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text",
        "url",
        "used_in"
      ],
      "properties": {
        "type": {
          "enum": [
            "sep",
            "iep",
            "gutenberg",
            "wikisource",
            "ctext",
            "cbeta",
            "doi",
            "sach",
            "khac"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "texts_seen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "archive": {
          "$ref": "#/$defs/url"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "used_in": {
          "$ref": "#/$defs/used_in"
        },
        "verified": {
          "$ref": "#/$defs/verified"
        }
      },
      "if": {
        "required": [
          "archive"
        ]
      },
      "then": {
        "required": [
          "accessed"
        ]
      }
    },
    "evidence": {
      "description": "Khóa trong sources.yml hoặc URL đã mở khi kiểm; rỗng khi mới rút.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified": {
      "description": "null tới khi được kiểm ở đợt 5; khi kiểm: ngày và người/phiên kiểm.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "by"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "used_in": {
      "description": "Đơn vị dùng bản ghi này: trang.md#id (lz.units), hoặc people/<id> cho hồ sơ.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+/)*[a-z0-9-]+\\.md#[A-Za-z0-9_-]+$|^people/[a-z0-9-]+$"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    }
  }
}
