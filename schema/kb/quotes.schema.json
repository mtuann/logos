{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtuann.github.io/logos/schema/kb/quotes.schema.json",
  "title": "Trích dẫn (data/kb/quotes.yml)",
  "description": "Mỗi khối trích dẫn một bản ghi, chữ giữ nguyên như trên trang. Khóa <tác giả>.<tác phẩm>.<vị trí> khi rút được.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "title",
        "original",
        "translation",
        "translator",
        "license",
        "used_in",
        "evidence",
        "verified"
      ],
      "properties": {
        "work": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "type": "string"
        },
        "original": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        },
        "translator": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "license": {
          "enum": [
            "public-domain",
            "fair-use-short",
            "unknown"
          ]
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "used_in": {
          "$ref": "#/$defs/used_in"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "verified": {
          "$ref": "#/$defs/verified"
        }
      }
    },
    "evidence": {
      "description": "Khóa trong sources.yml hoặc URL đã mở khi kiểm; rỗng khi mới rút.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified": {
      "description": "null tới khi được kiểm ở đợt 5; khi kiểm: ngày và người/phiên kiểm.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "by"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "used_in": {
      "description": "Đơn vị dùng bản ghi này: trang.md#id (lz.units), hoặc people/<id> cho hồ sơ.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+/)*[a-z0-9-]+\\.md#[A-Za-z0-9_-]+$|^people/[a-z0-9-]+$"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    }
  }
}
