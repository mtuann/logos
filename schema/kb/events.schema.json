{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtuann.github.io/logos/schema/kb/events.schema.json",
  "title": "Sự kiện (data/kb/events.yml)",
  "description": "Ứng viên sự kiện rút từ bài (năm + câu); đợt con 5.2 lọc và kiểm. certainty theo nhãn trong bài nếu có.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "text",
        "certainty",
        "used_in",
        "evidence",
        "verified"
      ],
      "properties": {
        "year": {
          "type": "integer"
        },
        "year_label": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "certainty": {
          "enum": [
            null,
            "chac-chan",
            "co-co-so",
            "suy-doan"
          ]
        },
        "used_in": {
          "$ref": "#/$defs/used_in"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "verified": {
          "$ref": "#/$defs/verified"
        }
      }
    },
    "evidence": {
      "description": "Khóa trong sources.yml hoặc URL đã mở khi kiểm; rỗng khi mới rút.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified": {
      "description": "null tới khi được kiểm ở đợt 5; khi kiểm: ngày và người/phiên kiểm.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "by"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "used_in": {
      "description": "Đơn vị dùng bản ghi này: trang.md#id (lz.units), hoặc people/<id> cho hồ sơ.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+/)*[a-z0-9-]+\\.md#[A-Za-z0-9_-]+$|^people/[a-z0-9-]+$"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    }
  }
}
