{
  "name": "logos",
  "private": true,
  "description": "Logos — website triết học tiếng Việt. Kiểm thử tự động.",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:site",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:site": "node --test --test-concurrency=1 \"tests/browser/*.test.js\"",
    "test:real": "node --test --test-concurrency=1 \"tests/real/*.test.js\"",
    "anh": "node tests/real/anh.js"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "lunr": "2.3.9",
    "playwright": "1.64.1"
  }
}
